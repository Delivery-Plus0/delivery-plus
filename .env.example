# Copy this file to .env for local development. Keep .env out of version control.
# --- Shared infrastructure ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379

KAFKA_BROKERS=localhost:9092
# Transactional outbox relay poll interval (order-service, delivery-service); commits also kick it immediately
OUTBOX_RELAY_INTERVAL_MS=500
# delivery-service: release drivers left BUSY after a finished delivery (0 disables the sweep)
DRIVER_RECONCILE_SWEEP_MS=60000
DRIVER_RECONCILE_GRACE_MS=60000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
INTERNAL_AUTH_SECRET=change-me-in-production
INTERNAL_AUTH_ALLOWED_SERVICES=menu-service,order-service

# Local S3-compatible media storage (SeaweedFS's S3 gateway in the dev/test
# Compose profiles, service name `media-storage`; see
# .project-context/15-media-and-storage.md for why this isn't MinIO).
# Replace local credentials and URLs with your cloud provider/CDN settings outside local development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=delivery-plus-media
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_PUBLIC_BASE_URL=http://localhost:9000/delivery-plus-media
AWS_S3_FORCE_PATH_STYLE=true

NODE_ENV=development

# Service behavior
PAYMENT_SUCCESS_RATE=0.9
LOCATION_TTL_SECONDS=300
# A driver position older than this is reported as STALE ("last seen"), not LIVE. Drivers report every 10 s.
LOCATION_STALE_AFTER_SECONDS=60
# Realtime tracking stream (SSE): keepalive comment interval, and the full reload that re-authorizes
# the subscriber and covers a lost Redis pub/sub message.
TRACKING_STREAM_HEARTBEAT_MS=15000
TRACKING_STREAM_RESYNC_MS=30000

# Local service overrides, when running one service outside Docker:
# SERVICE_NAME=auth-service
# PORT=3001
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service
# USER_SERVICE_URL=http://localhost:3002
# ORDER_SERVICE_URL=http://localhost:3006
# DRIVER_SERVICE_URL=http://localhost:3009
# DELIVERY_SERVICE_URL=http://localhost:3008
