{
  "openapi": "3.0.3",
  "info": {
    "title": "Delivery Plus Admin API",
    "version": "1.0.0",
    "description": "Staff admin contract for the Delivery Plus platform (#212). Each service owns its own /admin routes; the gateway publishes them under /api/admin/<service>. Requires a staff JWT (role ADMIN) carrying the route's permissions; SYSTEM tokens are refused with 401. Every mutation requires a reason and goes through the audit hook (#213)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "orders",
      "description": "orders admin endpoints"
    }
  ],
  "paths": {
    "/api/admin/orders": {
      "get": {
        "summary": "List all orders (staff with support.read)",
        "tags": [
          "orders"
        ],
        "operationId": "admin_orders_get_api_admin_orders",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Free-text search"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdAt:asc",
                "createdAt:desc"
              ],
              "default": "createdAt:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A PaginatedResult<T>",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT, or a SYSTEM token on an admin route"
          },
          "403": {
            "description": "Staff token without the required permission"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
