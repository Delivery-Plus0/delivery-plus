{
  "openapi": "3.0.3",
  "info": {
    "title": "Delivery Plus Admin API",
    "version": "1.0.0",
    "description": "Staff admin contract for the Delivery Plus platform (#212). Each service owns its own /admin routes; the gateway publishes them under /api/admin/<service>. Requires a staff JWT (role ADMIN) carrying the route's permissions; SYSTEM tokens are refused with 401. Every mutation requires a reason and goes through the audit hook (#213)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "orders",
      "description": "orders admin endpoints"
    },
    {
      "name": "audit",
      "description": "audit admin endpoints"
    }
  ],
  "paths": {
    "/api/admin/orders": {
      "get": {
        "summary": "List all orders (staff with support.read)",
        "description": "Requires staff permission: support.read.",
        "tags": [
          "orders"
        ],
        "operationId": "admin_orders_get_api_admin_orders",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "support.read"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, at most 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "A full order id; anything else matches nothing.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "One order.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "required": false,
            "description": "Orders of one customer.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "restaurantId",
            "in": "query",
            "required": false,
            "description": "Orders of one restaurant.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "active = not finished, completed = DELIVERED, cancelled = CANCELLED or FAILED.",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "completed",
                "cancelled"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order by creation time.",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt:asc",
                "createdAt:desc"
              ],
              "default": "createdAt:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A PaginatedResult<T>",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "limit",
                    "total",
                    "totalPages"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT, or a SYSTEM token on an admin route"
          },
          "403": {
            "description": "Staff token without the required permission"
          }
        }
      }
    },
    "/api/admin/audit": {
      "get": {
        "summary": "List staff actions, newest first (staff with audit.read)",
        "description": "Requires staff permission: audit.read.",
        "tags": [
          "audit"
        ],
        "operationId": "admin_audit_get_api_admin_audit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "audit.read"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, at most 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "required": false,
            "description": "The staff member who acted.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "required": false,
            "description": "What was acted on.",
            "schema": {
              "type": "string",
              "enum": [
                "USER",
                "DRIVER",
                "RESTAURANT",
                "ORDER",
                "DELIVERY",
                "PAYMENT",
                "MENU_ITEM",
                "STAFF"
              ]
            }
          },
          {
            "name": "targetId",
            "in": "query",
            "required": false,
            "description": "The id of what was acted on.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "description": "A dotted action, e.g. driver.approve.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Inclusive, ISO 8601.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Exclusive, ISO 8601.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A PaginatedResult<T>",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "limit",
                    "total",
                    "totalPages"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT, or a SYSTEM token on an admin route"
          },
          "403": {
            "description": "Staff token without the required permission"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
