{
  "name": "food-delivery-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run lint && npm test && npm run build",
    "verify": "npm run test:ci",
    "openapi:generate": "tsx scripts/generate-public-openapi.ts",
    "openapi:validate": "tsx scripts/validate-public-openapi.ts",
    "migration:generate": "npm run migration:generate --workspaces --if-present",
    "migration:run": "npm run migration:run --workspaces --if-present",
    "migration:revert": "npm run migration:revert --workspaces --if-present",
    "migration:show": "npm run migration:show --workspaces --if-present",
    "seed": "tsx scripts/seed.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "http-proxy-middleware": "^4.2.0"
  }
}
