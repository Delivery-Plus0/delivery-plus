{
  "name": "food-delivery-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run lint && npm test && npm run build",
    "verify": "npm run test:ci",
    "openapi:generate": "tsx scripts/generate-public-openapi.ts",
    "openapi:validate": "tsx scripts/validate-public-openapi.ts",
    "migration:generate": "npm run migration:generate --workspaces --if-present",
    "migration:run": "npm run migration:run --workspaces --if-present",
    "migration:revert": "npm run migration:revert --workspaces --if-present",
    "migration:show": "npm run migration:show --workspaces --if-present",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "e2e": "tsx scripts/e2e.ts",
    "kafka:dlq": "tsx scripts/kafka-dlq.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "e2e:env:up": "docker compose -p delivery-plus-e2e -f docker-compose.base.yml -f docker-compose.test.yml -f docker-compose.e2e.yml up -d --build --wait --wait-timeout 300",
    "e2e:env:down": "docker compose -p delivery-plus-e2e -f docker-compose.base.yml -f docker-compose.test.yml -f docker-compose.e2e.yml down --volumes --remove-orphans",
    "e2e:env:reset": "npm run e2e:env:down && npm run e2e:env:up && npm run seed:e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "http-proxy-middleware": "^4.2.0"
  }
}
