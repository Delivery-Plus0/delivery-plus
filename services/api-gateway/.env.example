SERVICE_NAME=api-gateway
PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Required when NODE_ENV=production; the localhost app ports otherwise.
# CORS_ORIGINS=https://app.example.com,https://restaurant.example.com

# How many reverse proxies in front of the gateway append the client's address to X-Forwarded-For
# (#251): 0 when clients connect directly (the default; a client's own X-Forwarded-For is ignored),
# 1 behind one load balancer, 2 behind a CDN and a load balancer. A whole number from 0 to 5.
TRUSTED_PROXY_HOPS=0

AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
RESTAURANT_SERVICE_URL=http://localhost:3003
MENU_SERVICE_URL=http://localhost:3004
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
DELIVERY_SERVICE_URL=http://localhost:3008
DRIVER_SERVICE_URL=http://localhost:3009
TRACKING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
