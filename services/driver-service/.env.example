SERVICE_NAME=driver-service
PORT=3008
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/driver_service

JWT_SECRET=change-me-in-production

# #206 test hook: new drivers start VERIFIED (local and test stacks only; refused in production).
DRIVER_AUTO_VERIFY=true

# #207: rate limits on document uploads and staff document reads.
REDIS_URL=redis://localhost:6379

# #207: the private driver documents bucket (never the public media bucket). Required in production.
DRIVER_DOCUMENTS_BUCKET=delivery-plus-private
# #207: the national ID HMAC key. Has a default only in development and test; production needs
# a long random value, different from the JWT secrets.
# NATIONAL_ID_HMAC_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
