SERVICE_NAME=payment-service
PORT=3007
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_service

JWT_SECRET=change-me-in-production

ORDER_SERVICE_URL=http://localhost:3006

# Payment simulator (#201). Defaults: hooks off, every payment succeeds.
# PAYMENT_TEST_HOOKS=true accepts the simulateFailure test hook and a success rate below 1.
# Test stacks only: refused in production.
PAYMENT_TEST_HOOKS=false
# Probability (0-1) that a simulated payment succeeds; anything below 1 needs PAYMENT_TEST_HOOKS=true.
PAYMENT_SUCCESS_RATE=1
# NODE_ENV=production refuses to start with the simulator unless this is true (closed demo only).
PAYMENT_SIMULATOR_IN_PRODUCTION=false
