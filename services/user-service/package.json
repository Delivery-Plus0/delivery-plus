{
  "name": "@food-delivery/user-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests",
    "migration:generate": "node ../../scripts/typeorm-migration-runner.js user-service run",
    "migration:run": "node ../../scripts/typeorm-migration-runner.js user-service run",
    "migration:revert": "node ../../scripts/typeorm-migration-runner.js user-service revert",
    "migration:show": "node ../../scripts/typeorm-migration-runner.js user-service show"
  },
  "dependencies": {
    "@food-delivery/shared": "0.1.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/swagger": "^7.4.2",
    "typeorm": "^0.3.20",
    "pg": "^8.12.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
